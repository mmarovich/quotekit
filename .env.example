# Copy these into Vercel → Project → Settings → Environment Variables
# Never commit real keys.

# From Stripe Dashboard → Developers → API keys (use Test keys first)
STRIPE_SECRET_KEY=sk_test_...

# From Stripe Dashboard → Product → Pricing → Price ID (price_...)
STRIPE_PRICE_ID=price_...

# Your live site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://quotekit-silk.vercel.app

# Optional: random long string for signing the Pro cookie
# If omitted, STRIPE_SECRET_KEY is used
PRO_COOKIE_SECRET=change-me-to-a-long-random-string
